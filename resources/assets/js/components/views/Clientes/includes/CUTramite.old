<template>
	<div>
		<tramite-previsional :baseUri="baseUri" :actionPerm="'tramites'" :info="info" :selectedItem="selectedItem" @clientes:tramites-close="closeAmModal" @clientes:tramites-saved="closeAmModal" :canSave="canSave"></tramite-previsional>

		<!--form id="frm" @submit.prevent="save()" :data-vv-scope="'tramites'" v-if="!benModal.show">
